# Synapse bridge config — copy to ~/.config/synapse-tg/config.toml or synapse-wx/config.toml
# and fill in your values. Only the sections relevant to your channel are needed.

# ── Telegram ──────────────────────────────────────────
[bot]
# Get from @BotFather on Telegram
token = ""

[tg]
# Authorized recipient chat id for outbound notes (cross-channel drop).
# REQUIRED for the outbox feature — without it, note delivery is disabled.
# chat_id = 123456789

[outbox]
# Bridge scan cadence for pending outbox notes (seconds).
poll_interval_s = 5
# Inline send-call retries per bubble before the row is marked failed.
# NOT whole-row redelivery: a crash-orphan claimed row is failed, never resent.
retry_max = 3

# ── Cortex shell (tg) ─────────────────────────────────
# Active iff shell_enabled AND shell_id below is a member of marrow's
# [cortex].shells. Inactive = plain relay resident (no scheduler, no silence
# cycle, no cortex env).
[cortex]
# Hard off-switch for this instance. Set false on any secondary bot instance:
# shell_id defaults to "tg", which IS in marrow's list, so a second instance
# left on would race the primary for the same socket and ledger.
shell_enabled = true
# Shell id handed to marrow as MARROW_CORTEX; must appear in marrow's
# [cortex].shells list for the resident to get the cortex tools.
shell_id = "tg"
# Ledger shared with marrow: <dir>/<shell>.json (session_id / next_wake_at /
# last_note_ts / occupancy / context_tier / pending_note / rotate_pending /
# tokens_today_base +
# tokens_date = today's finished-session tokens, dated in [core].timezone).
# Keep the socket path SHORT — macOS caps an
# AF_UNIX path at 104 bytes. marrow's [cortex].shell_socket must match.
shell_state_dir = "~/.config/marrow/state/shells"
shell_socket = "~/.config/marrow/state/shells/tg.sock"
# Minutes of user silence before one rendered note turn is fed to the resident.
# Keep in step with cortex's [watchdog].silent_max_min (the cli shell's
# free-round cycle) — same cadence on both shells.
shell_idle_min = 20
# argv printing the wakeup note on stdout. Empty = every round is skipped.
# Pass `--shell <shell_id>` so cortex drops THIS shell's own channel from the
# note's Replay section — without it the shell replays its own conversation
# back at itself every round.
# Pass `--no-ct` too: the marrow hook delivers ct-targeted notes via its outbox,
# so a render that also peeks them doubles them in the same payload.
# e.g. ["~/CC-Lab/cortex/.venv/bin/python", "-m", "cortex.note_render", "--no-ct", "--shell", "tg"]
note_render_cmd = []
note_render_timeout_s = 20
# Consecutive render failures that raise one alert (a broken renderer mutes
# every autonomous round silently). 0 = never alert.
note_render_alert_after = 3
# Machine tag opening a fed turn — must be a marrow [cortex].machine_markers
# member, else the fed note reads as a real user message.
shell_note_tag = "⏳ [NEW ROUND]"
# Context occupancy at which the resident is asked to wrap up and is then
# respawned fresh. 0 disables the fuse.
fuse_tokens = 300000
fuse_tag = "⚙️ [FUSE]"
# fuse_prompt_text = "..."
# Visible context broadcast: one plain "🗃️ Context <N>k" line to the chat when
# occupancy reaches context_notify_start, then every context_notify_step above
# it (once per tier per window). false = never announce.
context_notify = true
context_notify_start = 150000
context_notify_step = 50000

# ── WeChat ────────────────────────────────────────────
[user]
# Your wxid — run `python -m synapse_wx.ilink` to find it after QR login
target_wxid = ""

[loop]
poll_interval_sec = 1.0
# Spacing between outbound reply bubbles (seconds).
bubble_gap_sec = 0.8
# Outbound-edge bubble cap (wx): adjacent text bubbles are merged until a
# turn fits within this many. Main defense vs the iLink send count quota.
bubble_cap = 10

[send]
# (wx) On a business rejection (ret!=0 → iLink send count quota exhausted), wait
# this long (seconds) for the quota window to roll over, then retry once.
quota_wait_sec = 65.0
# (tg) Max attempts per outbound bubble on a 429 RetryAfter before giving up.
send_retry_max = 2
# (tg) If Telegram's RetryAfter exceeds this many seconds, skip the wait and
# treat the send as failed instead of stalling the bridge.
retry_after_cap_sec = 60.0
# (tg) HTTPX transport timeouts (seconds) for the Telegram Bot. read timeout
# must stay above the long-poll timeout (10s) so a poll never times out early.
http_connect_timeout_s = 10.0
http_read_timeout_s = 30.0
http_write_timeout_s = 30.0
http_pool_timeout_s = 10.0

# ── Shared ────────────────────────────────────────────
[provider]
cc_path = "claude"
# Default cwd for claude sessions started by the bridge
cwd = ""
# Enable marrow memory integration (requires marrow install)
marrow_bridge = false
# Where claude stores its project data (auto-detected if blank)
cc_projects_dir = ""
# Storm guard: more than this many unsolicited (background-task) turns
# delivered within one lock-hold raises a bridge_turn_storm alert. 0 disables.
unsolicited_storm_cap = 5

[storage]
# Runtime data directory. Default: ~/.config/synapse-{channel}/
data_dir = ""

[persona]
# Display names in messages
user_name = ""
assistant_name = ""

[marrow]
# Only needed if marrow_bridge = true
db = "~/.config/marrow/marrow.db"

[cwd_presets]
# Named shortcuts for /cwd N. Key = name shown in the menu, value = absolute
# path. Document order = the digit the user types (first entry is 1).
# proj-a = "/path/to/project-a"
# proj-b = "/path/to/project-b"

[alerts]
# Command to pipe alerts into marrow (optional)
marrow_repo_cmd = ""

[ack_overrides]
# Override any bridge ack string. Key = message key, value = {style = "text"}.
# Keys listed in synapse_core/commands/messages.py MESSAGES dict.
# Supports {placeholder} format vars from the original template.
# [ack_overrides."provider.dead"]
# cn = "挂了，烧钱重启中"
# en = "Provider down."
# [ack_overrides."clear.ok"]
# cn = "开张 ({name})"

[debug]
raw_poll_log_until = ""
